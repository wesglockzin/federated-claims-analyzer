# env.config template — configuration reference for local development.
#
# IMPORTANT: this is a template. Copy to `env.config` and fill in real values.
# `env.config` is never committed and never published.
#
# In Azure Container Apps the same names are secrets injected as env vars.

# --- The tool's own sign-in gate (Okta OIDC; unset = gate disabled, local dev only) ---
OIDC_ISSUER="https://your-org.okta.com"
OIDC_CLIENT_ID="your-oidc-client-id"
OIDC_CLIENT_SECRET="[REDACTED]"
APP_BASE_URL="https://localhost:8080"

# --- Flask ---
FLASK_SECRET_KEY="your-flask-secret-key-here"

# --- Okta tester OIDC clients (per environment) ---
OKTA_DEV_OIDC_SECRET="[REDACTED]"
OKTA_STG_OIDC_SECRET="[REDACTED]"
OKTA_PROD_OIDC_SECRET="[REDACTED]"

# --- Okta API tokens (Token Lifetime Check only; read-only) ---
OKTA_DEV_API_TOKEN="[REDACTED]"
OKTA_PROD_API_TOKEN="[REDACTED]"

# --- ADFS tester OIDC clients ---
ADFS_DEV_CLIENT_SECRET="[REDACTED]"
ADFS_PROD_CLIENT_SECRET="[REDACTED]"

# --- Optional toggles ---
APP_AUTH_GATE_ENABLED="true"
FORCE_FRESH_LOGIN_DEFAULT="true"
