# Copy to `.env` (docker compose) or `env.config` (python app.py) and fill in.
# Neither file is committed. Every value below is a placeholder.
# A setting marked "required" has no default: the app stops at startup and
# names the missing setting.

# --- Port and public URL ---
# PORT: port the server listens on (default 8080)
PORT=8080
# APP_BASE_URL (required): the public URL users open, with no trailing slash.
# It builds the redirect URIs. Over https the session cookie is
# SameSite=None; Secure. Over http it is SameSite=Lax, and SAML sign-in
# (a cross-site POST back from the IdP) needs https.
APP_BASE_URL=

# --- Session key (required; same value on every worker) ---
FLASK_SECRET_KEY=

# --- The tool's own sign-in (OIDC) ---
# AUTH_MODE: "oidc" (default) or "none". In "oidc" mode the app refuses to
# start without the three OIDC_* settings and an allow-list. "none" serves
# every route without a login: local development only.
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_SCOPES: scopes requested at sign-in (default "openid email profile").
# Add the scope your IdP needs to release groups when you use ALLOWED_GROUPS.
OIDC_SCOPES=openid email profile
# Allow-list (required in "oidc" mode: set at least one). Comma-separated.
# A user may sign in when their email is listed, or when their OIDC_GROUPS_CLAIM
# claim contains a listed group.
ALLOWED_EMAILS=
ALLOWED_GROUPS=
# OIDC_GROUPS_CLAIM: claim that holds the user's groups (default "groups")
OIDC_GROUPS_CLAIM=groups

# --- Okta environments (any number; list the names you use) ---
# OKTA_ENVIRONMENTS: comma-separated names, for example DEV,STG,PROD. Each
# name <N> needs the first three settings below; the rest are optional.
#   OKTA_<N>_ISSUER          issuer URL of the authorization server
#   OKTA_<N>_CLIENT_ID       client id of the tester's OIDC app
#   OKTA_<N>_OIDC_SECRET     its client secret
#   OKTA_<N>_AUDIENCE        access-token audience (default: the client id)
#   OKTA_<N>_DEFAULT_ISSUER  adds an "Org Auth Server (default)" choice
#   OKTA_<N>_DEFAULT_AUDIENCE  its audience (default "api://default")
#   OKTA_<N>_API_TOKEN       read-only API token for the Token Lifetime Check
OKTA_ENVIRONMENTS=
# OKTA_DEV_ISSUER=
# OKTA_DEV_CLIENT_ID=
# OKTA_DEV_OIDC_SECRET=
# OKTA_DEV_API_TOKEN=

# --- ADFS environments (any number) ---
# ADFS_ENVIRONMENTS: comma-separated names. Each name <N> needs
# ADFS_<N>_ISSUER, ADFS_<N>_CLIENT_ID and ADFS_<N>_CLIENT_SECRET.
# At least one of OKTA_ENVIRONMENTS and ADFS_ENVIRONMENTS must be set.
ADFS_ENVIRONMENTS=
# ADFS_DEV_ISSUER=
# ADFS_DEV_CLIENT_ID=
# ADFS_DEV_CLIENT_SECRET=

# --- SAML IdPs (any number; optional) ---
# SAML_IDPS: comma-separated keys of the form OKTA_<target> or ADFS_<target>,
# for example OKTA_DEV,ADFS_DEV. Each key <K> needs:
#   SAML_<K>_ENTITY_ID   IdP entity id
#   SAML_<K>_SSO_URL     IdP single sign-on URL
#   SAML_<K>_CERT        IdP signing certificate as PEM text (use \n for newlines)
#   SAML_<K>_ENV         environment name the app appears under in the form
# Optional per key: SAML_<K>_LABEL (name in the form), SAML_<K>_SP_ENTITY_ID
# (default: SAML_SP_ENTITY_ID), SAML_<K>_SP_CERT_FILE and SAML_<K>_SP_KEY_FILE
# (default saml_tester.cert and saml_tester.key beside the app).
SAML_IDPS=
# SAML_SP_ENTITY_ID (required when SAML_IDPS is set): this tool's entity id
SAML_SP_ENTITY_ID=

# --- SAML signing key pair as PEM text (cloud or Kubernetes only; locally
# the files saml_tester.cert and saml_tester.key beside the app are used) ---
SAML_TESTER_CERT=
SAML_TESTER_KEY=

# --- Behavior ---
# FORCE_FRESH_LOGIN_DEFAULT: ask the IdP for a fresh login (default true)
FORCE_FRESH_LOGIN_DEFAULT=true

# --- Set by the platform, not by you ---
# K_SERVICE, KUBERNETES_SERVICE_HOST and CONTAINER_APP_NAME are set by Cloud
# Run, Kubernetes and Azure Container Apps. When any is present the app sends
# a Strict-Transport-Security header, uses the log format without timestamps,
# and (for the first two) reads the SAML key pair from SAML_TESTER_CERT/KEY.

# --- smoke_test.py only ---
# SMOKE_TLS_VERIFY: "false" skips TLS verification in the post-deploy checks
# (default true)
SMOKE_TLS_VERIFY=true
