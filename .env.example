# Copy to `.env` (docker compose) or `env.config` (python app.py) and fill in.
# Neither file is committed. Every value below is a placeholder.

# --- Port and public URL ---
# PORT: port the server listens on (default 8080)
PORT=8080
# APP_BASE_URL: public base URL, used for redirect URIs and cookie flags
# (default http://localhost:8080)
APP_BASE_URL=http://localhost:8080

# --- Session key (required; same value on every worker) ---
FLASK_SECRET_KEY=

# --- The tool's own sign-in (OIDC) ---
# AUTH_MODE: "oidc" (default) or "none". The app refuses to start in "oidc"
# mode unless the three OIDC_* settings below are set. "none" serves every
# route without a login: local development only.
AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Okta tester OIDC clients (DEV required, others optional) ---
OKTA_DEV_OIDC_SECRET=
OKTA_STG_OIDC_SECRET=
OKTA_PROD_OIDC_SECRET=

# --- Okta API tokens (Token Lifetime Check only; read-only) ---
OKTA_DEV_API_TOKEN=
OKTA_PROD_API_TOKEN=

# --- ADFS tester OIDC clients (required) ---
ADFS_DEV_CLIENT_SECRET=
ADFS_PROD_CLIENT_SECRET=

# --- SAML signing key pair as PEM text (cloud or Kubernetes only; locally
# the files saml_tester.cert and saml_tester.key beside the app are used) ---
SAML_TESTER_CERT=
SAML_TESTER_KEY=

# --- Behavior ---
# FORCE_FRESH_LOGIN_DEFAULT: ask the IdP for a fresh login (default true)
FORCE_FRESH_LOGIN_DEFAULT=true
